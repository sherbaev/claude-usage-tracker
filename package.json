{
  "name": "claude-usage-tracker",
  "version": "0.10.0",
  "description": "Claude Multi-Device Usage Tracker — track Claude 5-hour and weekly plan limits per device: per-device usage, caps, and model / effort breakdown for Claude Code, with a web dashboard.",
  "type": "module",
  "private": true,
  "bin": {
    "usage-tracker": "plugin/scripts/cli.js",
    "ccw": "plugin/scripts/cli.js"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test --experimental-test-coverage 'test/**/*.test.js'",
    "start": "node --disable-warning=ExperimentalWarning server/src/server.js",
    "validate": "claude plugin validate . && claude plugin validate ./plugin && claude plugin validate ./pane"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": "https://github.com/sherbaev/claude-usage-tracker",
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "claude-code-plugin",
    "usage-tracker",
    "usage-limits",
    "rate-limit",
    "multi-device",
    "ccusage",
    "anthropic",
    "self-hosted",
    "dashboard",
    "codex",
    "gemini-cli",
    "opencode",
    "telegram"
  ]
}
